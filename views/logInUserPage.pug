doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title #{title} - log in 
        script(src="js/login.js" defer) 
        link(rel="stylesheet", href="/css/login.css")
    body
        #mainContainer
            header
                #siteTitleSection
                    p#titleHeader= title
                    p#subtext #{title} helps you connect and share information.
                #logInUserSection
                    input.loginElement(type="text", name="username", id="usernameInputElement", placeholder="Username")
                    input.loginElement(type="password", name="password", id="passwordInputElement", placeholder="Password")
                    button.loginElement(id="loginButton") Log in
            footer
                #additionalInformation
                    p Collaboration between Emil, Jonas, Mikkel
                    p @#{title}


