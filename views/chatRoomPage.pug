doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= title  
        script(type="module", src="/js/chatroom.js" defer) 
        link(rel="stylesheet", href="/chat.css")
        link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=delete")
    body 

    div(class="chat-section")
        div(class="chat-header", id="chatHeader")
            div(id="chatId", data-chatId= chatId, data-userLevel= userLevel, data-createdByUser= createdByUser, data-userId= userId)= chatName 

            if createdByUser == userId || userLevel === 3
                span(class="material-symbols-outlined", id="deleteButton") delete
        
        div(class="message-section")
            each message in messages 
                    if message.createdByUser == userId 
                        .wrapper.sent
                            div(class="message message-sent")
                                p= message.createdByUser
                                p= message.text
                                if(userLevel >= 2)
                                    span(class="material-symbols-outlined deleteLeft deleteMessage", data-messageId=message.id) delete    

                    else 
                        .wrapper.received
                            div(class="message message-received")
                                p= message.createdByUser 
                                p= message.text
                                if(userLevel == 3)
                                    span(class="material-symbols-outlined deleteRight deleteMessage", data-messageId=message.id) delete 



        if userLevel > 1                  
            div(class="input-section")
                input(id="msg")
                button(id="sendButton" data-userId= userId) send



//
        if createdByUser == userId || userLevel === 3
            input#chatNameLabel(type="text", value= chatName)
            button#deleteChatButton(data-userId= userId, data-chatId= chatId) delete chat
            button#updateChatButton(date-userId= userId, data-chatId= chatId) update chat
        else 
            p= chatName

        header 
            if createdByUser == userId || userLevel === 3
                input#chatNameLabel(type="text", value= chatName)
                button#deleteChatButton(data-userId= userId, data-chatId= chatId) delete chat
                button#updateChatButton(date-userId= userId, data-chatId= chatId) update chat
            else 
                p= chatName

        #chatThreadSection
            each message in messages
                if message.createdByUser == userId
                    include includes/sendMessageElement
                else
                    include includes/receivedMessageElement

        if userLevel > 1
            #createMessageSection
                input#messageInputElement(type="text", name="messageInput", data-userId= userId, data-chatId= chatId)
                button#sendMessageButton(type="button") send message
