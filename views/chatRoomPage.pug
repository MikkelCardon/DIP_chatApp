doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= title 
        script(src="/js/updateChat.js" defer)
        script(src="/js/deleteMessage.js" defer)
        script(src="/js/deleteChat.js" defer)
        script(src="/js/sendMessage.js" defer) 
    body 

    header 
        if createdByUser == userId || userLevel === 3
            input#chatNameLabel(type="text", value= chatName)
            button#deleteChatButton(data-userId= userId, data-chatId= chatId) delete chat
            button#updateChatButton(date-userId= userId, data-chatId= chatId) update chat
        else 
            p= chatName

    #chatThreadSection
        each message in messages
            if message.createdByUser == userId
                include includes/sendMessageElement
            else
                include includes/receivedMessageElement

    if userLevel > 1
        #createMessageSection
            input#messageInputElement(type="text", name="messageInput", data-userId= userId, data-chatId= chatId)
            button#sendMessageButton(type="button") send message