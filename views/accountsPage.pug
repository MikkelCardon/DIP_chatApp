doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/navigationbar.css")
        link(rel="stylesheet", href="/css/accountPage.css")
        script(src="/js/navigationbar.js" defer) 
        script(src="/js/createUser.js" defer) 
        script(src="/js/deleteUser.js" defer) 
        title= title 
    body 
        include includes/navigationbar 
        
        if accessedUser.userLevel == 3
            .container
                .accounts
                    h1 Account Overview
                    each user in users 
                        .usersOverview 
                            div
                                .values
                                    h4 Username 
                                    p #{user.username}
                                .values
                                    h4 Password 
                                    p #{user.password}
                            div
                                h5 Created: #{user.dateOfCreation}
                                h5 User level: #{user.userLevel}
                            button(data-userId= user.userId) Delete
                .div 
                    h1 Account Registration
                    .registration-container
                        h2 Register New Account
                        .group 
                            label(for="username") Username
                            input(type="text", name="username", id="usernameInput", placeholder="Username")
                        .group 
                            label(for="password") Password
                            input(type="password", name="password", id="passwordInput", placeholder="Password")
                        .group
                            label(for="userLevel") User Level
                            input(type="number", name="userLevel", id="userLevelInput", placeholder="1-3")
                            .helper-text Enter a level between 1 and 3

                        button#registerUserButton Register

        else 
            h1 Your account
            .usersOverview 
                div
                    .values
                        h4 Username 
                        p #{accessedUser.username}
                    .values
                        h4 Password 
                        p #{accessedUser.password}
                div
                    h5 Created: #{accessedUser.dateOfCreation}
                    h5 User level: #{accessedUser.userLevel}
