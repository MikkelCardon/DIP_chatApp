doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        script(type="module", src="/js/events/createChatButton.js" defer) 
        script(type="module", src="/js/events/navigationbar.js" defer) 
        link(rel="stylesheet", href="/css/navigationbar.css")
        link(rel="stylesheet", href="/css/homepage.css")
        title= title 
    body 
        include includes/navigationbar
        
        #homePageContainer
            #chatHeader
                h1#chatTitle Welcome to the Chat

            #availableChats
                #availableChatsLabel All chats 
                each chat in chats
                    .availableChatElement
                        a(href=`/chats/${chat.id}`) #{chat.name}
            
            if userLevel >= 2
                #createChatSection 
                    input#chatNameInput(type="text", placeholder="What is your chat name?")
                    button#createChatButton Create chat
            
            

