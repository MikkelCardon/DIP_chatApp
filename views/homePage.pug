doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        script(src="/js/createChat.js" defer) 
        script(src="/js/navigationbar.js" defer) 
        title= title 
    body 
        include includes/navigationbar

        h1 Welcome to the Chat 
        span#errors 

        if userLevel === 3
            #createChatSection 
                input#chatNameInput(type="text", placeholder="Chatname?")
                button#createChatButton create

        #availableChats 
            each chat in chats
                .availableChatElement
                    a(href=`/chats/${chat.id}`) #{chat.name}